# HireFlow AI — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to source control.

# ─── API Configuration ────────────────────────────────────────────────────────

# Base URL for the backend API.
#
# Phase 1 (current — local/mock):  Leave blank. Falls back to http://localhost:3000
# Phase 2 (AWS API Gateway):       Set to your API Gateway invoke URL, e.g.:
#   VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com/prod
#
# NOTE: Must be prefixed with VITE_ to be exposed to the browser by Vite.
VITE_API_BASE_URL=

# ─── Future variables (add here as phases are implemented) ───────────────────

# AWS Cognito (Phase 2 — Auth)
# VITE_COGNITO_USER_POOL_ID=
# VITE_COGNITO_CLIENT_ID=
# VITE_COGNITO_REGION=ap-south-1

# AWS Region
# VITE_AWS_REGION=ap-south-1

# Amazon S3 — Resume uploads (Phase 3)
# VITE_S3_BUCKET_NAME=
# VITE_S3_REGION=ap-south-1
